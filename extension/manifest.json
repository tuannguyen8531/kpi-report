{
  "manifest_version": 3,
  "name": "KPI · Giờ làm việc",
  "version": "1.0.0",
  "description": "Theo dõi giờ GitLab theo ngày, tuần, tháng và ghi lịch nghỉ trên máy.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_popup": "src/popup.html", "default_title": "Giờ làm việc", "default_icon": "assets/icon.png"},
  "icons": {"128": "assets/icon.png"}
}
