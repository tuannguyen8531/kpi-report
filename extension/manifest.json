{
  "manifest_version": 3,
  "name": "KPI · Work hours",
  "version": "1.0.0",
  "description": "Track daily, weekly, and monthly GitLab hours and manage leave locally.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_popup": "src/popup.html", "default_title": "Work hours", "default_icon": "assets/icon.png"},
  "icons": {"128": "assets/icon.png"}
}
